{
  "expo": {
    "name": "CassaFi",
    "slug": "eas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cassafi",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08090a",
    "ios": {
      "bundleIdentifier": "money.cassafi.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "metamask",
          "trust",
          "rainbow",
          "uniswap",
          "zerion",
          "safe",
          "rabby",
          "okx",
          "bitget",
          "coinbase",
          "cbwallet"
        ]
      }
    },
    "android": {
      "package": "money.cassafi.app",
      "adaptiveIcon": {
        "backgroundColor": "#08090a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08090a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/GeneralSans-Regular.otf",
            "./assets/fonts/GeneralSans-Medium.otf",
            "./assets/fonts/GeneralSans-Semibold.otf",
            "./assets/fonts/Newsreader-Italic.ttf",
            "./assets/fonts/DMMono-Regular.ttf",
            "./assets/fonts/DMMono-Medium.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "165bbd57-a347-47b6-97a3-e59864139370"
      }
    },
    "owner": "trixenais-team"
  }
}
